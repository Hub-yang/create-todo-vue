{
  "name": "@huberyyang/create-todo-vue",
  "type": "module",
  "version": "1.0.1",
  "packageManager": "pnpm@11.25.0",
  "description": "💡 create vue projects with awesome templates",
  "author": "HuberyYang",
  "license": "MIT",
  "homepage": "https://github.com/Hub-yang/create-todo-vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hub-yang/create-todo-vue.git"
  },
  "bugs": {
    "url": "https://github.com/Hub-yang/create-todo-vue/issues"
  },
  "keywords": [
    "scripts",
    "node",
    "bash",
    "bin",
    "sh",
    "cli",
    "template"
  ],
  "bin": {
    "create-todo-vue": "bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "template-lit",
    "template-lit-ts",
    "template-vanilla",
    "template-vanilla-ts",
    "template-vue",
    "template-vue-ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "preview": "pnpm build && node ./bin/index.js",
    "build": "tsdown",
    "build:prod": "pnpm typecheck && pnpm lint:fix && pnpm test && pnpm build && pnpm test:e2e",
    "release": "pnpm build:prod && bumpp && npm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts",
    "typecheck": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "taze": "npx taze major -r",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@clack/prompts": "^1.7.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@huberyyang/todo-scripts": "^1.3.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.4.1",
    "bumpp": "^12.3.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
